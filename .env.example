APP_NAME="City Max Crypto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the origin you open in the browser (scheme + host + port), e.g. http://127.0.0.1:8080
APP_URL=http://localhost
APP_TAGLINE="CREATE • CONNECT • CONQUER"
SUPPORT_EMAIL=support@citymaxcrypto.com
SEO_TITLE="City Max Crypto | Daily ROI & USDT Packages in Malaysia"
SEO_DESCRIPTION="City Max Crypto is a Malaysia crypto platform with USDT packages, 1% daily ROI, referral and binary income, and fast USDT withdrawals on TRC20 and BEP20."
SEO_KEYWORDS="City Max Crypto, CityMax, CityMax Crypto, City Max, citymax, citymax crypto Malaysia, crypto Malaysia, USDT Malaysia, Kuala Lumpur crypto, daily ROI, binary income, referral income, USDT TRC20, USDT BEP20"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: sqlite. For production use pgsql (recommended) or mysql.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=city_max_crypto
# DB_USERNAME=postgres
# DB_PASSWORD=

# MySQL alternative:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=city_max_crypto
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Production: SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.zeptomail.in
MAIL_PORT=587
MAIL_USERNAME=emailapikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@citymaxcrypto.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# City Max Crypto — calc service (must match cmc-node-bgt INTERNAL_API_KEY)
CALC_SERVICE_URL=http://127.0.0.1:3001
CALC_INTERNAL_API_KEY=change-me-city-max-internal-key
CALC_REQUEST_TIMEOUT=30

# Receive money: manual | nowpayments
PAYMENT_PROVIDER=manual
# Send crypto (withdrawals): manual | nowpayments
PAYOUT_PROVIDER=manual

# NOWPayments secrets & settings (https://documenter.getpostman.com/view/7907941/2s93JusNJt)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_2FA_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_PRICE_CURRENCY=usd
NOWPAYMENTS_PAYOUT_CURRENCY=usdttrc20
NOWPAYMENTS_PAYOUT_CURRENCY_TRC20=usdttrc20
NOWPAYMENTS_PAYOUT_CURRENCY_BEP20=usdtbsc
NOWPAYMENTS_PAYOUT_FIAT_CURRENCY=usd
NOWPAYMENTS_VALIDATE_ADDRESS=true
NOWPAYMENTS_HTTP_TIMEOUT=30
NOWPAYMENTS_AUTH_TIMEOUT=20
NOWPAYMENTS_JWT_CACHE_MINUTES=4

# Required: no code defaults — set these in every environment.
WITHDRAWAL_MINIMUM=10
WITHDRAWAL_FEE=2
MEMBERSHIP_WEEKDAYS=200
MEMBERSHIP_EXPIRY_WARNING_DAYS=10
INCOME_REFERRAL_PERCENT=10
INCOME_BINARY_PERCENT=5
# 00:00 Malaysia time (INCOME_TIMEZONE) pays the previous Malaysia calendar day (00:00–23:59). ROI is skipped Sunday and Monday.
INCOME_RUN_AT=00:00
INCOME_TIMEZONE=Asia/Kuala_Lumpur
# Production must stay unset/false. local/testing allow NOWPayments stubs.
# PAYMENT_ALLOW_STUB=false

# php artisan db:seed truncates all data, then recreates packages + admin (id 1) + parent customer (id 3558).
# Change these credentials in production.
SEED_ADMIN_ID=1
SEED_ADMIN_NAME="City Max Admin"
SEED_ADMIN_EMAIL=admin@citymaxcrypto.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_ID=3558
SEED_CUSTOMER_NAME="Root Customer"
SEED_CUSTOMER_EMAIL=root@citymaxcrypto.com
SEED_CUSTOMER_PASSWORD=Customer@123
SEED_CUSTOMER_PHONE=0000000000
SEED_CUSTOMER_COUNTRY=US

# After DatabaseSeeder: php artisan db:seed --class=DummyPowerIdSeeder
# Creates N left + N right Power ID chains under root (default 100+100 = 200).
SEED_DUMMY_POWER_IDS_PER_SIDE=100
