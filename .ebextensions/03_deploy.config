container_commands:
  00_chmod_hooks:
    command: "chmod -R +x .platform/hooks || true"
  00_storage:
    command: "mkdir -p storage/logs storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache && chown -R webapp:webapp storage bootstrap/cache && chmod -R ug+rwx storage bootstrap/cache"
  01_migrations:
    command: "set -o pipefail; php artisan migrate --force 2>&1 | tee /var/log/laravel-migrate.log"
  02_optimize:
    command: "php artisan route:cache && php artisan view:cache && php artisan storage:link || true"
