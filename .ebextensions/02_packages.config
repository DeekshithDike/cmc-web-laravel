packages:
  yum:
    git: []
    postgresql15: []

commands:
  01_php_pgsql:
    command: |
      set -e
      VER=$(rpm -q php-common --queryformat '%{VERSION}-%{RELEASE}')
      if dnf install -y "php-pgsql-${VER}"; then
        echo "installed php-pgsql-${VER}"
      else
        dnf install -y php-pgsql
      fi
